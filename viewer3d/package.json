{
  "name": "zhuda-common-3d-viewer",
  "private": true,
  "type": "module",
  "description": "prefabs 的 3D 觀看台：用網址叫出任何一個共用 3D 場景（?scene=<id>），也是 3D 模組的整合測試。",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync": "node ../scripts/sync.mjs .",
    "sync:check": "node ../scripts/sync.mjs . --check",
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "zhuda-laya-doctor --project .",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run sync && npm run sync:check && npm run build && npm run typecheck && npm run doctor && npm test",
    "view": "node tools/serve.mjs 8930"
  },
  "dependencies": {
    "zhuda-laya-engine": "git+https://github.com/zhudaandzhuer/zhuda-laya-engine.git#57b3acecfab8c2f4ec6568e55258df48767e9a1d"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
